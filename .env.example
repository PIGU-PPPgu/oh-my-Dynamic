# oh-my-Dynamic 环境变量配置示例
# 复制此文件为 .env 并填入你的 API Key
# cp .env.example .env

# ===== 选择你使用的模型 provider，取消注释并填入对应的 Key =====

# --- 智谱 GLM（默认 provider）---
# 获取地址：https://open.bigmodel.cn/
ZHIPUAI_API_KEY=your_zhipu_key_here

# --- OpenAI GPT ---
# 获取地址：https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here

# --- Anthropic Claude ---
# 获取地址：https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_key_here

# --- Google Gemini ---
# 获取地址：https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your_google_key_here

# --- OpenRouter（聚合多模型）---
# 获取地址：https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_key_here

# ===== 可选配置 =====

# 默认模型（不设则默认 glm-5.1）
# LLM_DEFAULT_MODEL=gpt-4o

# OpenAI 兼容接口的 base URL（DeepSeek、通义千问等需要）
# LLM_BASE_URL=https://api.deepseek.com/v1

# GLM 的 OpenAI 兼容接口 base URL（仅在 zhipuai SDK 未安装时使用）
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 通用回退 API Key（任何未匹配的 provider 都会尝试此 key）
# LLM_API_KEY=your_fallback_key_here
